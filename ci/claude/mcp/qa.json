{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser", "chromium",
        "--no-sandbox",
        "--output-dir", "agent-artifacts",
        "--caps", "testing"
      ]
    }
  }
}
