{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_markdown", "acceptance_criteria", "open_questions", "estimated_scope"],
  "properties": {
    "spec_markdown": {
      "type": "string",
      "description": "The product spec: problem statement, user stories, scope in/out. Proportional to ticket size — a small feature gets a small spec."
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "description": { "type": "string", "description": "Observable, testable behavior through the UI or API" }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "estimated_scope": { "type": "string", "enum": ["small", "medium", "large"] }
  }
}
