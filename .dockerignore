data
test-results
**/test-results
agent-artifacts
__pycache__
**/__pycache__
*.pyc
.wrangler
**/.wrangler
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
.hypothesis
**/.hypothesis
agent-out
# Volume-mounted into their containers at runtime; never copied into images.
vendor-mock
toxiproxy
